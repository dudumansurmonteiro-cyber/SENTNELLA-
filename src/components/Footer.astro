---
const ano = new Date().getFullYear();
---
<footer class="rodape">
  <div class="container rodape-grade">
    <div>
      <p class="rodape-marca">Sentinella</p>
      <p class="texto-2">
        <span class="sob-consulta">[razão social e CNPJ em definição]</span><br />
        São Paulo
      </p>
    </div>
    <nav aria-label="Rodapé" class="rodape-links">
      <a href="/como-operamos">Como operamos</a>
      <a href="/piloto">Projeto-piloto</a>
      <a href="/privacidade">Política de privacidade</a>
      <a href="/termos">Termos</a>
      <span class="texto-2">LinkedIn <span class="sob-consulta">(em definição)</span></span>
    </nav>
    <p class="texto-2 rodape-nota">© {ano} Sentinella. Central de operação humana das 8h às 22h.</p>
  </div>
</footer>

<style>
  .rodape {
    margin-top: clamp(4rem, 9vw, 7.5rem);
    border-top: 1px solid var(--line);
    padding-block: 2.5rem 2.8rem;
    font-size: 0.92rem;
  }
  .rodape-grade {
    display: grid;
    gap: 1.6rem;
  }
  .rodape-marca {
    font-family: 'Bricolage Grotesque', sans-serif;
    font-weight: 600;
    font-size: 1.1rem;
    margin-bottom: 0.4rem;
  }
  .rodape-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.6rem;
  }
  .rodape-links a { color: var(--ink); }
  .rodape-nota { font-size: 0.85rem; }
  @media (min-width: 900px) {
    .rodape-grade {
      grid-template-columns: 1fr auto;
      align-items: start;
    }
    .rodape-nota { grid-column: 1 / -1; }
  }
</style>
