---
const emCasa = Astro.url.pathname === '/';
const raiz = (ancora: string) => (emCasa ? ancora : `/${ancora}`);
---
<header class="topo">
  <div class="container topo-linha">
    <a class="marca" href="/" aria-label="Sentinella — página inicial">
      <svg width="19" height="25" viewBox="24 0 152 200" aria-hidden="true">
        <path
          fill="currentColor"
          d="M46 10H154Q166 10 166 22V98Q166 144 100 190Q34 144 34 98V22Q34 10 46 10Z"
        ></path>
        <path
          class="olho"
          d="M61 92Q100 59 139 92Q100 125 61 92Z"
        ></path>
        <circle fill="currentColor" cx="100" cy="92" r="14"></circle>
      </svg>
      Sentinella
    </a>
    <nav aria-label="Principal">
      <a href="/como-operamos">Como operamos</a>
      <a href={raiz('#planos')}>Planos</a>
      <a href="/piloto">Projeto-piloto</a>
      <a class="topo-contato" href={raiz('#contato')}>Agendar diagnóstico</a>
    </nav>
  </div>
</header>

<style>
  .topo {
    border-bottom: 1px solid var(--line-soft);
  }
  .topo-linha {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.6rem 1.5rem;
    padding-block: 1rem;
  }
  .marca {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-family: 'Bricolage Grotesque', sans-serif;
    font-weight: 600;
    font-size: 1.25rem;
    color: var(--ink);
    text-decoration: none;
  }
  .marca svg { color: var(--primary); }
  .marca .olho { fill: var(--bg); }
  nav {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.4rem 1.4rem;
    font-size: 0.95rem;
  }
  nav a {
    color: var(--ink);
    text-decoration: none;
  }
  nav a:hover { text-decoration: underline; text-underline-offset: 3px; }
  .topo-contato {
    border: 1.5px solid var(--primary);
    border-radius: 4px;
    padding: 0.45rem 0.95rem;
    color: var(--link);
    font-weight: 500;
  }
  @media (prefers-color-scheme: dark) {
    .marca svg { color: var(--ink); }
    .topo-contato { border-color: var(--link); }
  }
  @media (max-width: 480px) {
    nav { font-size: 0.9rem; gap: 0.4rem 1rem; }
  }
</style>
